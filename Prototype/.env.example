# Salin menjadi .env.local. Environment sistem memiliki prioritas.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Agen percakapan untuk halaman pendengar; lihat setup/agen-elevenlabs.md.
ELEVENLABS_AGENT_ID=
# Opsional: hanya dibutuhkan untuk gambar yang belum ada di cache.
GEMINI_API_KEY=
# Cadangan teks (ringkasan, perintah suara) saat semua key Gemini habis kuota. Citra tetap lewat Gemini.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it
